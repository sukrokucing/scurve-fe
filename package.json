{
  "name": "scurve-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--trace-warnings NODE_TLS_REJECT_UNAUTHORIZED=0 vite --host --port 3001",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run qa:tables && npm run audit:perf:strict",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host --port 3001",
    "seed:demo-personas": "node scripts/seed-persona-demo.mjs",
    "seed:dashboard-demo": "node scripts/seed-dashboard-demo.mjs",
    "seed:team-demo": "node scripts/seed-team-demo.mjs",
    "test:e2e": "playwright test",
    "test:e2e:persona": "playwright test e2e/persona-workflows.spec.ts",
    "test:e2e:project-settings": "playwright test e2e/project-settings-relocation.spec.ts --project=chromium",
    "test:e2e:projects-mobile": "playwright test e2e/projects-mobile-actions.spec.ts --project=chromium",
    "test:e2e:roles-live": "playwright test e2e/roles-dialog-live.spec.ts --project=chromium --workers=1",
    "test:e2e:user-access-live": "playwright test e2e/user-access-live.spec.ts --project=chromium --workers=1",
    "test:e2e:menu": "playwright test e2e/menu-hierarchy.spec.ts e2e/menu-hierarchy-mobile.spec.ts e2e/menu-shell-smoke.spec.ts --project=chromium --workers=1",
    "test:e2e:ui-state": "playwright test e2e/ui-state-persistence.spec.ts --project=chromium",
    "test:e2e:tasks-health": "playwright test e2e/tasks-derived-health.spec.ts --project=chromium",
    "test:e2e:flows": "playwright test e2e/business-flows.spec.ts",
    "test:e2e:smoke": "playwright test e2e/console-smoke.spec.ts",
    "test:e2e:perf": "playwright test e2e/perf-probes.spec.ts --project=chromium",
    "test:e2e:critical": "playwright test e2e/console-smoke.spec.ts e2e/menu-hierarchy.spec.ts e2e/menu-hierarchy-mobile.spec.ts e2e/menu-shell-smoke.spec.ts e2e/perf-probes.spec.ts --project=chromium --workers=1",
    "generate:e2e:scenario": "node scripts/generate-scenario-tests.mjs business_flow.yaml",
    "test:e2e:scenario": "playwright test e2e/generated/business-flow.generated.spec.ts",
    "sync:openapi": "node scripts/sync-openapi.mjs",
    "generate:types": "node scripts/generate-openapi-types.mjs --source=local",
    "generate:types:remote": "node scripts/generate-openapi-types.mjs --source=remote",
    "generate:zod": "node scripts/generate-zod.js",
    "generate:schemas": "npm run generate:types && npm run generate:zod",
    "generate:schemas:remote": "npm run sync:openapi && npm run generate:schemas",
    "generate:theme": "node scripts/generate-theme-tokens.mjs",
    "check:theme": "node scripts/check-theme-tokens.mjs",
    "audit:ui": "node scripts/ui-audit/run-ui-audit.mjs --mode=full --gate",
    "audit:ui:mode": "node scripts/ui-audit/run-ui-audit.mjs",
    "audit:perf": "node scripts/perf-audit/run-perf-audit.mjs",
    "audit:perf:strict": "node scripts/perf-audit/run-perf-audit.mjs --gate",
    "perf:baseline": "node scripts/upgrade/perf-baseline.mjs",
    "perf:compare": "node scripts/upgrade/perf-compare.mjs",
    "visual:baseline": "node scripts/upgrade/visual-baseline.mjs",
    "visual:compare": "node scripts/upgrade/visual-compare.mjs",
    "upgrade:tailwind4:canary": "node scripts/upgrade/run-tailwind4-canary.mjs",
    "upgrade:gate": "npm run check && npm run build && npm run audit:ui && npm run perf:compare && npm run visual:compare",
    "qa:be-update:20260311": "node scripts/qa/verify-be-update-20260311.mjs",
    "qa:tables": "node scripts/qa/verify-table-stack.mjs"
  },
  "dependencies": {
